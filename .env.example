# ────────────────────────────────────────
# RVIOS — قالب متغيّرات البيئة
# انسخه إلى .env واملأ القيم الحقيقية.
#
# ⚠️  هذا الملف متتبَّع في git. لا تضع فيه قيمة حقيقية أبداً —
#     عناصر نائبة فقط. القيم الحقيقية تُضبط في لوحة Render/Vercel.
# ────────────────────────────────────────

# ── قاعدة البيانات ────────────────────
# محلياً: Postgres على جهازك، ويكفي أن يتطابق DIRECT_URL مع DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rvios_db"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/rvios_db"

# على Supabase — انسخهما من Dashboard ← Connect:
#   DATABASE_URL = Transaction pooler  (المنفذ 6543)  + ?pgbouncer=true
#   DIRECT_URL   = Session pooler      (المنفذ 5432)
# لا تستخدم db.<ref>.supabase.co المباشر: IPv6 فقط، وRender يخرج بـ IPv4.

# ── Redis ─────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────
# ولّد كل واحد بـ:  openssl rand -hex 32
JWT_SECRET="<generate-with-openssl-rand-hex-32>"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<generate-with-openssl-rand-hex-32>"
JWT_REFRESH_EXPIRES_IN="7d"

# ── الـ API ───────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# ── Cloudflare R2 ─────────────────────
CF_ACCOUNT_ID="<cloudflare-account-id>"
CF_ACCESS_KEY_ID="<r2-access-key-id>"
CF_SECRET_ACCESS_KEY="<r2-secret-access-key>"
CF_BUCKET_NAME="rvios-media"
CF_PUBLIC_URL="https://<account-id>.r2.cloudflarestorage.com/rvios-media"

# ── الواجهات ──────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3002"
NEXT_PUBLIC_OWNER_URL="http://localhost:3003"

# ── بذرة حساب المدير ──────────────────
# اختر قيمة جديدة عند كل تهيئة — لا تُعِد استخدام كلمة مرور منشورة.
SEED_ADMIN_EMAIL="<admin-email>"
SEED_ADMIN_PASSWORD="<choose-a-strong-unique-password>"
