{
  "shadow": {
    "$description": "شبه معدومة عمداً — الفصل في «أرشيف ملكي» بالخطوط لا بالظل.",
    "xs":   "0 1px 0 rgba(25,19,16,.04)",
    "sm":   "0 1px 2px rgba(25,19,16,.06)",
    "md":   "0 2px 8px rgba(25,19,16,.07)",
    "lg":   "0 8px 28px rgba(25,19,16,.10)",
    "glow": "0 0 0 1px #C8A45D"
  },

  "shadowDark": {
    "xs":   "0 1px 0 rgba(0,0,0,.3)",
    "sm":   "0 1px 2px rgba(0,0,0,.4)",
    "md":   "0 2px 8px rgba(0,0,0,.5)",
    "lg":   "0 8px 28px rgba(0,0,0,.6)",
    "glow": "0 0 0 1px #C8A45D"
  },

  "motion": {
    "fast": "150ms",
    "base": "300ms",
    "slow": "600ms"
  },

  "ease": {
    "out":    "cubic-bezier(.16,1,.3,1)",
    "in-out": "cubic-bezier(.65,0,.35,1)",
    "spring": "cubic-bezier(.34,1.56,.64,1)"
  },

  "z": {
    "base": "0",
    "dropdown": "100",
    "sticky": "200",
    "overlay": "300",
    "modal": "400",
    "toast": "500"
  }
}
